# LLM-Klassifikation (mindestens eine Variante setzen)

# Bevorzugt: Groq Free Tier (Key beginnt mit gsk_)
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-20b

# Alternativen
# XAI_API_KEY=
# OPENAI_API_KEY=

# Vercel AI Gateway (Fallback, wenn kein Provider-Key gesetzt ist)
# Lokal: Key aus dem Vercel Dashboard — oder `vercel env pull` für OIDC
# AI_GATEWAY_API_KEY=
# AI_GATEWAY_MODEL=openai/gpt-oss-20b
